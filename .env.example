# ==========================================================================
# Digital Bank Locker Management Platform — environment configuration
# Copy this file to .env and adjust values. Never commit real secrets.
# ==========================================================================

# --- Postgres ---
POSTGRES_USER=locker_user
POSTGRES_PASSWORD=locker_pass
POSTGRES_DB=locker_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://locker_user:locker_pass@postgres:5432/locker_db
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_TTL_SECONDS=300
VERIFICATION_TOKEN_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_MINUTE=5
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Admin web ---
VITE_API_BASE_URL=http://localhost:8000
ADMIN_WEB_PORT=3000

# --- Demo accounts (development only, documented — never use in production) ---
# customer@demo.bank / operator@demo.bank / manager@demo.bank / admin@demo.bank
# Password for all demo accounts: Demo@1234
